---
import PricingLink from "./PricingLink.astro";
import site from "../data/site.json";

interface Props {
  placement: string;
}
const { placement } = Astro.props;
const { business, pages } = site;
const pricing = pages.quote;
---
<div class="rounded-2xl border border-clay/70 bg-fog p-6 sm:p-8 shadow-soft">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-sage">Event &amp; recurring rentals</p>
  <h2 class="mt-3 text-2xl sm:text-3xl font-display text-ink">{pricing.panel_title}</h2>
  <p class="mt-4 text-ink/80">{pricing.explanation}</p>
  <ol class="mt-6 space-y-4">
    {pricing.steps.map((step, index) => (
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sage text-fog text-sm font-bold">{index + 1}</span>
        <div>
          <p class="font-semibold text-ink">{step.title}</p>
          <p class="text-sm text-ink/75">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="mt-7">
    <PricingLink placement={placement} class="pricing-button w-full sm:w-auto" />
  </div>
  <p class="mt-5 border-t border-clay pt-5 text-sm text-ink/80">{pricing.note}</p>
  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
    <a href={`tel:${business.phone_tel}`} class="inline-flex min-h-11 items-center font-semibold text-sage underline underline-offset-4">Call {business.phone_display}</a>
    <a href={`sms:${business.phone_tel}`} class="inline-flex min-h-11 items-center font-semibold text-sage underline underline-offset-4">Text us</a>
  </div>
</div>
