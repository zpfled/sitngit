---
import PricingLink from "./PricingLink.astro";
import site from "../data/site.json";
const { business, services, service_area, pages, labels } = site;
---
<footer class="bg-sand border-t border-clay/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="space-y-4">
        <p class="font-display text-lg text-ink">{business.name}</p>
        <p class="text-sm text-ink/70">{business.tagline}</p>
        <div class="space-y-2 text-sm">
          <p><a href={`tel:${business.phone_tel}`} class="text-ink font-semibold">{business.phone_display}</a></p>
          <p><a href={`mailto:${business.email}`} class="text-ink/70">{business.email}</a></p>
        </div>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink mb-3">{labels.footer_services}</p>
        <ul class="space-y-2 text-sm">
          {services.map((service) => (
            <li><a href={`/services/${service.slug}/`} class="text-ink/70 hover:text-ink">{service.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink mb-3">{labels.footer_service_area}</p>
        <ul class="space-y-2 text-sm">
          {service_area.counties.map((county) => (
            <li><a href={`/service-area/${county.slug}/`} class="text-ink/70 hover:text-ink">{county.name}</a></li>
          ))}
        </ul>
      </div>
      <div class="space-y-3">
        <p class="text-sm font-semibold text-ink">{pages.contact.cta.title}</p>
        <p class="text-sm text-ink/70">{pages.contact.cta.body}</p>
        <PricingLink placement="footer" />
        <a href="/get-a-quote/" class="flex min-h-11 items-center text-sm text-sage underline underline-offset-4">How online pricing works</a>
      </div>
    </div>
    <div class="mt-10 border-t border-clay/70 pt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-xs text-ink/60">
      <p>© {new Date().getFullYear()} {business.name}. {labels.rights_reserved}</p>
      <div class="flex items-center gap-4">
        <p class="font-semibold text-ink/70">{labels.footer_legal}</p>
        <a href="/terms-of-service/" class="hover:text-ink">{labels.footer_terms}</a>
        <a href="/privacy-policy/" class="hover:text-ink">{labels.footer_privacy}</a>
      </div>
    </div>
  </div>
</footer>
