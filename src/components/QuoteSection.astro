---
import InstantPricing from "./InstantPricing.astro";
import SiteImage from "./SiteImage.astro";
import site from "../data/site.json";

const quoteBackground = site.pages.quote.background_image;
---
<section id="quote" class="relative overflow-hidden py-16 sm:py-20">
  <SiteImage src={quoteBackground} alt="" sizes="100vw" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-ink/85"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] items-center">
      <div id="quote-form"><InstantPricing placement="quote-section" /></div>
      <div class="text-fog lg:pl-6">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-fog">Easy online pricing.<br />A local team when you need us.</h2>
        <p class="mt-4 text-base sm:text-lg text-fog/90 max-w-xl">Planning a wedding, community event, or construction project? See your price and book online, or call or text us to arrange your rental.</p>
        <p class="mt-4 text-fog/90 max-w-xl">For servicing a unit you own, special arrangements, or help choosing equipment, call or text our team. We’re happy to help.</p>
        <a href="/get-a-quote/" class="mt-5 inline-flex min-h-11 items-center text-fog underline underline-offset-4 hover:text-ember">How online pricing and booking work <span aria-hidden="true" class="ml-2">→</span></a>
      </div>
    </div>
  </div>
</section>
