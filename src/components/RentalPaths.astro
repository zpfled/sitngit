---
import site from "../data/site";
const rentals = site.services.filter((service) => ["event-rentals", "construction-rentals"].includes(service.slug));
---
<section class="py-8 sm:py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-display">Plan your rental</h2>
    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {rentals.map((service) => (
        <a href={`/services/${service.slug}/`} class="block rounded-2xl border border-clay bg-white p-6 hover:border-sage">
          <h3 class="text-xl font-display">{service.name}</h3>
          <p class="mt-3">{service.short}</p>
          <span class="mt-4 inline-block font-semibold underline underline-offset-4">View rental details</span>
        </a>
      ))}
    </div>
  </div>
</section>
