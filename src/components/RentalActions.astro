---
import site from "../data/site.json";
import PricingLink from "./PricingLink.astro";

interface Props {
  intent?: "event" | "long-term";
  placement?: string;
  serviceOnly?: boolean;
}
const { intent, placement = "rental-actions", serviceOnly = false } = Astro.props;
---
<div class="flex flex-wrap gap-3">
  {serviceOnly ? (
    <a href={`tel:${site.business.phone_tel}`} class="pricing-button">Call about servicing</a>
  ) : <PricingLink placement={placement} intent={intent} />}
  <a href={`${serviceOnly ? "sms" : "tel"}:${site.business.phone_tel}`} class="inline-flex min-h-11 items-center justify-center px-5 py-3 rounded-full border border-ink/30 text-ink text-sm font-semibold hover:bg-ink/5">
    {serviceOnly ? "Text about servicing" : `Call ${site.business.phone_display}`}
  </a>
</div>
