---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  maxWidth?: number;
}
const { src, alt, class: className, sizes = "(min-width: 1024px) 50vw, 100vw", loading = "lazy", priority = false, maxWidth = 1600 } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/*.{jpg,jpeg,png,webp}");
const asset = images[`/public${src}`];
const metadata = asset ? (await asset()).default : undefined;
const width = metadata ? Math.min(metadata.width, maxWidth) : undefined;
const widths = width ? [...new Set([400, 800, 1200, width].filter((value) => value <= width))] : [];
---
{metadata ? (
  <Image src={metadata} alt={alt} class={className} width={width} widths={widths} sizes={sizes} format="webp" quality={78} loading={loading} fetchpriority={priority ? "high" : undefined} />
) : (
  <img src={src} alt={alt} class={className} loading={loading} fetchpriority={priority ? "high" : undefined} />
)}
