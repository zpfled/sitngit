---
import site from "../data/site.json";

interface Props {
  intent?: "event" | "long-term";
}
const { intent } = Astro.props;
const { cta_primary } = site.navigation;
// One entry point for rental CTAs; keep intent when the future booking route is ready.
const href = intent ? `${cta_primary.href}?type=${intent}` : cta_primary.href;
---
<div class="flex flex-wrap gap-3">
  <a href={href} data-rental-intent={intent} class="inline-flex min-h-11 items-center justify-center px-5 py-3 rounded-full bg-ink text-fog text-sm font-semibold shadow-soft hover:bg-ink/90">
    {cta_primary.label}
  </a>
  <a href={`tel:${site.business.phone_tel}`} class="inline-flex min-h-11 items-center justify-center px-5 py-3 rounded-full border border-ink/30 text-ink text-sm font-semibold hover:bg-ink/5">
    Call {site.business.phone_display}
  </a>
</div>
