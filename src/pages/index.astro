---
import RentalPaths from "../components/RentalPaths.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import ServiceShowcase from "../components/ServiceShowcase.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import QuoteSection from "../components/QuoteSection.astro";
import WhyChooseGrid from "../components/WhyChooseGrid.astro";
import site from "../data/site";
import googleReviews from "../data/google-reviews.json";

const { pages } = site;
const reviewRating = Number(googleReviews.summary.rating).toFixed(1);

---
<BaseLayout
  title="Portable Restroom Rentals in Southwest WI | Sit & Git Portables"
  description="Portable restroom rentals in Southwest WI for events and job sites across Vernon, Richland, and Crawford counties plus parts of Sauk and Iowa counties. See rental pricing online."
  googleSiteVerification="jvLNyifSNN40d8rzVpG1oDIzRaYsJq1drEeg36VxdqE"
>
  <Hero
    eyebrow={pages.home.hero.eyebrow}
    headline={pages.home.hero.headline}
    subhead={pages.home.hero.subhead}
    trustStrip={pages.home.hero.trust_strip}
    secondaryCta={pages.home.hero.secondary_cta}
    secondaryHref={pages.home.hero.secondary_href}
    media={pages.home.hero.media}
    panel={pages.home.hero.panel}
  />

  <div class="pt-16 sm:pt-20 lg:pt-24 pb-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-ink">
      <span class="font-semibold">{reviewRating} out of 5 · {googleReviews.summary.count} Google reviews</span>
      <a href="#customer-reviews" class="inline-flex min-h-11 items-center underline underline-offset-4">
        Read customer feedback
      </a>
    </div>
  </div>

  <RentalPaths />

  <ServiceShowcase
    title={pages.home.service_showcase.title}
    items={pages.home.service_showcase.items}
  />

  <GoogleReviews
    id="customer-reviews"
    title={pages.home.google_reviews.title}
    summary={googleReviews.summary}
    reviews={googleReviews.reviews}
  />

  <section class="py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl sm:text-2xl font-display text-ink text-center">
        {pages.home.sitelink_quick_links.title}
      </h2>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        {pages.home.sitelink_quick_links.items.map((item) => (
          <a
            href={item.href}
            class="inline-flex items-center justify-center rounded-full border border-ink/15 bg-white px-4 py-2 text-sm font-semibold text-ink hover:border-ink/30 hover:bg-ink/5"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 xl:gap-10 xl:grid-cols-[1.3fr_0.7fr] items-start">
        <div class="min-w-0">
          <h2 class="text-2xl sm:text-3xl font-display text-ink">Where we work</h2>
          <div class="mt-4"><ServiceAreaMap placement="home-map" /></div>
        </div>
        <div class="min-w-0 rounded-2xl border border-clay/70 bg-white p-6 sm:p-8 shadow-soft">
          <h2 class="text-2xl sm:text-3xl font-display text-ink">{pages.home.service_area.title}</h2>
          <div class="mt-4 w-16 h-[2px] bg-moss/70"></div>
          <p class="mt-4 text-sm text-ink/75">{pages.home.service_area.body}</p>
          <a
            href={pages.home.service_area.cta_href}
            class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-sage underline underline-offset-4 hover:text-ink"
          >
            Explore our service area
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-display text-ink text-center">
        {pages.home.why_choose.title}
      </h2>
      {pages.home.why_choose.body && (
        <p class="mt-3 text-sm sm:text-base text-ink/70 text-center max-w-2xl mx-auto">
          {pages.home.why_choose.body}
        </p>
      )}
      <WhyChooseGrid />
    </div>
  </section>

  <QuoteSection />
</BaseLayout>
