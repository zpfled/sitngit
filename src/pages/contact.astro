---
import BaseLayout from "../layouts/BaseLayout.astro";
import InstantPricing from "../components/InstantPricing.astro";
import site from "../data/site.json";

const { pages, business } = site;
---
<BaseLayout
  title={pages.contact.meta_title ?? pages.contact.title}
  description={pages.contact.meta_description ?? pages.contact.body}
>
  <section class="pt-12 sm:pt-16 pb-6 sm:pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-display text-ink">{pages.contact.title}</h1>
      <p class="mt-4 text-ink/75">{pages.contact.body}</p>
    </div>
  </section>

  <section class="pt-6 sm:pt-8 pb-12 sm:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] items-start">
        <div class="bg-fog border border-clay/70 rounded-2xl p-6 sm:p-8 shadow-soft space-y-6">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-moss mb-2">Hours</p>
            <p class="text-sm text-ink/80">{pages.contact.hours}</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-moss mb-2">Phone</p>
            <a href={`tel:${business.phone_tel}`} class="inline-flex min-h-11 items-center text-sm font-semibold text-ink hover:text-sage">
              {business.phone_display}
            </a>
            <a href={`sms:${business.phone_tel}`} class="flex min-h-11 items-center text-sm font-semibold text-sage underline underline-offset-4">Text our team</a>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-moss mb-2">Email</p>
            <a href={`mailto:${business.email}`} class="inline-flex min-h-11 items-center text-sm font-semibold text-ink hover:text-sage">
              {business.email}
            </a>
            <p class="text-sm text-ink/75">For servicing, special arrangements, or rental questions.</p>
          </div>
        </div>
        <div id="quote"><InstantPricing placement="contact-pricing" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
