---
import { Image } from "astro:assets";
import logoImage from "../assets/logo.png";
import badgeImage from "../assets/locally-owned.webp";
import PricingLink from "./PricingLink.astro";
import site from "../data/site.json";
const { navigation, business, labels } = site;
const logoSrc = business.logo?.src;
const isDefaultLogo = logoSrc === "/images/logo.png";
const badgeSrc = business.badge?.src;
const isDefaultBadge = badgeSrc === "/images/locally-owned.webp";
---
<header class="sticky top-0 z-40 text-fog">
  <div class="bg-ember text-ink text-xs sm:text-base font-bold font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 sm:py-1 flex items-center justify-center">
      <span class="uppercase tracking-[0.12em] sm:tracking-[0.2em]">{labels.superheader_call}</span>
      <a href={navigation.cta_secondary.href} class="inline-flex min-h-11 items-center ml-2 sm:ml-3 uppercase tracking-[0.12em] sm:tracking-[0.2em] text-ink hover:text-ink">
        {business.phone_display}
      </a>
    </div>
  </div>
  <div class="bg-sage border-b border-ink/10">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-2 sm:gap-4 py-2.5 sm:py-4 md:py-6">
      <a href="/" class="flex min-w-0 items-center gap-4">
        {business.logo?.src ? (
          isDefaultLogo ? (
            <Image src={logoImage} alt={business.logo.alt ?? business.name} class="h-12 min-[375px]:h-14 sm:h-20 md:h-24 w-auto" loading="eager" />
          ) : (
            <img src={business.logo.src} alt={business.logo.alt ?? business.name} class="h-12 min-[375px]:h-14 sm:h-20 md:h-24 w-auto" loading="eager" />
          )
        ) : (
          <span class="font-display text-xl text-fog">{business.name}</span>
        )}
      </a>
      <details class="lg:hidden">
        <summary class="cursor-pointer inline-flex min-h-11 items-center font-semibold text-fog">Menu <span aria-hidden="true" class="ml-2">▾</span></summary>
        <nav aria-label="Mobile navigation" class="absolute left-0 right-0 top-full max-h-[60vh] overflow-y-auto rounded-b-xl bg-sage p-4 shadow-lift">
          {navigation.primary.map((item) => (
            <a href={item.href} class="flex min-h-11 items-center px-3 text-fog hover:bg-white/10">{item.label}</a>
          ))}
        </nav>
      </details>
      <nav aria-label="Primary navigation" class="hidden lg:flex items-center gap-6 text-base font-semibold">
        {navigation.primary.map((item) => (
          <a href={item.href} class="text-fog/80 hover:text-fog">{item.label}</a>
        ))}
      </nav>
      <div class="hidden lg:flex items-center gap-4">
        {business.badge?.src && (
          isDefaultBadge ? (
            <Image src={badgeImage} alt={business.badge.alt ?? "Locally owned"} class="h-12 w-12" loading="lazy" />
          ) : (
            <img src={business.badge.src} alt={business.badge.alt ?? "Locally owned"} class="h-12 w-12" loading="lazy" />
          )
        )}
        <PricingLink placement="header-desktop" />
      </div>
      <PricingLink placement="header-mobile" class="pricing-button lg:hidden shrink-0 px-3 text-xs sm:text-sm" />
    </div>
  </div>
  </div>
</header>
